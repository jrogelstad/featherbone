{
    "name": "shipSettings",
    "module": "Ship",
    "description": "Ship settings",
    "properties": {
        "pickList": {
            "description": "Pick list print form",
            "type": {
                "relation": "PrintForm",
                "properties": [
                    "name",
                    "description",
                    "title",
                    "feather"
                ]
            }
        },
        "printOnRelease": {
            "description": "Print picklist when sales order is released",
            "type": "boolean"
        },
        "packingSlip": {
            "description": "Packing slip print form",
            "type": {
                "relation": "PrintForm",
                "properties": [
                    "name",
                    "description",
                    "title",
                    "feather"
                ]
            }
        },
        "printOnShip": {
            "description": "Print packing slip when shipment is shipped",
            "type": "boolean"
        },
        "useBackOrder": {
            "description": "Put partially shipped orders in back order status",
            "type": "boolean",
            "default": true
        }
    }
}