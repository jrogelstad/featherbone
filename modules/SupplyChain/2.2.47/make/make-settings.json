{
    "name": "makeSettings",
    "module": "Make",
    "description": "Make settings",
    "properties": {
        "defaultStatus": {
            "description": "Default status for new work orders",
            "type": "string",
            "default": "P",
            "dataList": [
                {
                    "value": "P",
                    "label": "Pending"
                },
                {
                    "value": "A",
                    "label": "Active"
                }
            ]
        },
        "traveler": {
            "description": "Work order traveler print form",
            "type": {
                "relation": "PrintForm",
                "properties": [
                    "name",
                    "description",
                    "title",
                    "feather"
                ]
            }
        },
        "printOnRelease": {
            "description": "Print traveler when work order is released",
            "type": "boolean"
        },
        "automaticClose": {
            "description": "Close work orders automatically when all quantities are received",
            "type": "boolean",
            "default": true
        }
    }
}