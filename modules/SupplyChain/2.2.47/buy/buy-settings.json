{
    "name": "buySettings",
    "module": "Buy",
    "description": "Buy settings",
    "properties": {
        "purchaseOrder": {
            "description": "Purchase order print form",
            "type": {
                "relation": "PrintForm",
                "properties": [
                    "name",
                    "description",
                    "title",
                    "feather"
                ]
            }
        },
        "onRelease": {
            "description": "Select what to do on purchase order release",
            "default": "N",
            "type": "string",
            "dataList": [
                {
                    "value": "N",
                    "label": "Do nothing"
                },
                {
                    "value": "E",
                    "label": "Email"
                },
                {
                    "value": "D",
                    "label": "Download"
                },
                {
                    "value": "O",
                    "label": "Open PDF"
                },
                {
                    "value": "P",
                    "label": "Print"
                }
            ]
        },
        "packingSlip": {
            "description": "Packing slip print form for outside processes",
            "type": {
                "relation": "PrintForm",
                "properties": [
                    "name",
                    "description",
                    "title",
                    "feather"
                ]
            }
        },
        "printOnShip": {
            "description": "Print packing slip when shipment is shipped",
            "type": "boolean"
        },
        "mailText": {
            "description": "Default message text for emailed purchase orders",
            "type": "string",
            "format": "richText"
        }
    }
}