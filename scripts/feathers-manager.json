[
    {
        "name": "Organization",
        "plural": "Organizations",
        "module": "Core",
        "inherits": "Document",
        "description": "A customer account. Owns instances and the identities that reach them",
        "authorizations": [],
        "properties": {
            "name": {
                "description": "Name of the organization",
                "type": "string",
                "isRequired": true,
                "isAlwaysLoad": true,
                "isNaturalKey": true,
                "isLabelKey": true
            },
            "isActive": {
                "description": "Whether the organization is active",
                "type": "boolean",
                "isRequired": true,
                "default": true,
                "isAlwaysLoad": true
            },
            "authentication": {
                "description": "How this organization's identities sign in",
                "type": "string",
                "format": "enum",
                "isRequired": true,
                "default": "password",
                "dataList": [
                    {
                        "value": "password",
                        "label": "Local password"
                    },
                    {
                        "value": "sso",
                        "label": "Single sign-on only"
                    },
                    {
                        "value": "both",
                        "label": "Either"
                    }
                ]
            },
            "isTwoFactorRequired": {
                "description": "Whether two-factor authentication is required",
                "type": "boolean",
                "isRequired": true,
                "default": false
            }
        }
    },
    {
        "name": "TenantService",
        "plural": "TenantServices",
        "module": "Core",
        "inherits": "Document",
        "description": "Tennant postgres service",
        "authorizations": [],
        "properties": {
            "name": {
                "description": "Name of service",
                "type": "string",
                "isRequired": true,
                "isAlwaysLoad": true,
                "isNaturalKey": true
            },
            "pgHost": {
                "description": "Postgres host url",
                "type": "string",
                "alias": "Host",
                "isRequired": true,
                "isLabelKey": true
            },
            "pgPort": {
                "description": "Postgres port number",
                "type": "string",
                "alias": "Port",
                "isRequired": true
            },
            "pgUser": {
                "description": "Administrative user",
                "type": "string",
                "alias": "User",
                "isRequired": true
            },
            "pgPassword": {
                "description": "Administrative user password",
                "type": "string",
                "alias": "Password",
                "format": "password",
                "isRequired": true,
                "isEncrypted": true
            }
        }
    },
    {
        "name": "Tenant",
        "plural": "Tenants",
        "inherits": "Document",
        "module": "Core",
        "description": "Map of companies to their database",
        "authorizations": [],
        "properties": {
            "name": {
                "description": "Name of company or instance",
                "type": "string",
                "isRequired": true,
                "isAlwaysLoad": true,
                "isNaturalKey": true
            },
            "contact": {
                "description": "Primary contact. Optional since tenant plan A.3: a contact belongs to the owning organization, and an instance created by the installer has no one to name",
                "type": {
                    "relation": "Contact",
                    "properties": [
                        "fullName",
                        "email",
                        "address",
                        "phone"
                    ]
                },
                "isRequired": false
            },
            "isActive": {
                "type": "boolean",
                "description": "Whether tennant is active",
                "isRequired": true,
                "default": true,
                "isAlwaysLoad": true
            },
            "pgService": {
                "description": "Postgres data service",
                "type": {
                    "relation": "TenantService",
                    "properties": [
                        "name",
                        "pgHost"
                    ]
                },
                "alias": "Service",
                "isRequired": true
            },
            "pgDatabase": {
                "description": "Postgres database name",
                "type": "string",
                "alias": "Database",
                "isRequired": true,
                "isAlwaysLoad": true,
                "isLabelKey": true
            },
            "modules": {
                "description": "List of modules installed on tenant",
                "type": "array",
                "isReadOnly": true,
                "isAlwaysLoad": true
            },
            "edition": {
                "description": "Edition of software used",
                "type": {
                    "relation": "Edition",
                    "properties": [
                        "name",
                        "description",
                        "maxSessions"
                    ]
                },
                "isReadOnly": false
            },
            "isDemo": {
                "description": "Flag whether demo database",
                "type": "boolean"
            },
            "expiration": {
                "description": "Expiration date",
                "type": "string",
                "format": "dateTime",
                "default": "null"
            },
            "organization": {
                "description": "Organization that owns this instance. Backfilled by A.5",
                "type": {
                    "relation": "Organization",
                    "properties": [
                        "name",
                        "isActive"
                    ]
                },
                "isAlwaysLoad": true
            },
            "isMaintenance": {
                "description": "Instance is down for a deployment (ADR-002 question 7). Sign-in and application requests are refused with an explanation rather than a 404; a platform administrator may still sign in, so an installation with one instance can bring it back. Deploy sets it and clears it",
                "type": "boolean",
                "isAlwaysLoad": true
            }
        }
    },
    {
        "name": "Identity",
        "plural": "Identities",
        "module": "Core",
        "inherits": "Document",
        "description": "A person within one organization. Owns the credential, not the database role",
        "authorizations": [],
        "properties": {
            "organization": {
                "description": "Organization this identity belongs to",
                "type": {
                    "relation": "Organization",
                    "properties": [
                        "name",
                        "isActive"
                    ]
                },
                "isRequired": true,
                "isAlwaysLoad": true
            },
            "username": {
                "description": "Sign-in name, unique within the organization",
                "type": "string",
                "isRequired": true,
                "isAlwaysLoad": true,
                "isLabelKey": true
            },
            "fullName": {
                "description": "Name of the person",
                "type": "string",
                "isRequired": true
            },
            "email": {
                "description": "Email address",
                "type": "string",
                "format": "email"
            },
            "passwordHash": {
                "description": "Verifier for the local password. Never a reversible secret",
                "type": "string",
                "isReadOnly": true
            },
            "status": {
                "description": "Whether this identity may sign in",
                "type": "string",
                "format": "enum",
                "isRequired": true,
                "default": "active",
                "isAlwaysLoad": true,
                "dataList": [
                    {
                        "value": "active",
                        "label": "Active"
                    },
                    {
                        "value": "suspended",
                        "label": "Suspended"
                    },
                    {
                        "value": "locked",
                        "label": "Locked out"
                    }
                ]
            },
            "isPlatformAdmin": {
                "description": "Platform administrator. Not a Postgres superuser",
                "type": "boolean",
                "isRequired": true,
                "default": false
            },
            "isOrgAdmin": {
                "description": "Administrator of their own organization",
                "type": "boolean",
                "isRequired": true,
                "default": false
            },
            "failedAttempts": {
                "description": "Consecutive failed sign-in attempts",
                "type": "integer",
                "isRequired": true,
                "default": 0,
                "isReadOnly": true
            },
            "lockedUntil": {
                "description": "Locked out until this time",
                "type": "string",
                "format": "dateTime",
                "default": "null",
                "isReadOnly": true
            },
            "lastSignedIn": {
                "description": "Last successful sign-in",
                "type": "string",
                "format": "dateTime",
                "default": "null",
                "isReadOnly": true
            }
        }
    },
    {
        "name": "AccessGrant",
        "plural": "AccessGrants",
        "module": "Core",
        "inherits": "Document",
        "description": "Which instances an identity may reach. The reachability boundary",
        "authorizations": [],
        "properties": {
            "identity": {
                "description": "Identity being granted access",
                "type": {
                    "relation": "Identity",
                    "properties": [
                        "username",
                        "fullName",
                        "status"
                    ]
                },
                "isRequired": true,
                "isAlwaysLoad": true
            },
            "tenant": {
                "description": "Instance the identity may reach",
                "type": {
                    "relation": "Tenant",
                    "properties": [
                        "name",
                        "pgDatabase"
                    ]
                },
                "alias": "Instance",
                "isRequired": true,
                "isAlwaysLoad": true
            },
            "isActive": {
                "description": "Whether the grant is in force",
                "type": "boolean",
                "isRequired": true,
                "default": true,
                "isAlwaysLoad": true
            },
            "granted": {
                "description": "When access was granted",
                "type": "string",
                "format": "dateTime",
                "default": "null"
            },
            "grantedBy": {
                "description": "Identity that granted the access",
                "type": {
                    "relation": "Identity",
                    "properties": [
                        "username",
                        "fullName"
                    ]
                }
            }
        }
    },
    {
        "name": "IdentityProvider",
        "plural": "IdentityProviders",
        "module": "Core",
        "inherits": "Document",
        "description": "How one organization's identities sign in through an identity provider (ADR-001 C.3)",
        "authorizations": [],
        "properties": {
            "organization": {
                "description": "Organization this provider signs in",
                "type": {
                    "relation": "Organization",
                    "properties": [
                        "name",
                        "isActive"
                    ]
                },
                "isRequired": true,
                "isAlwaysLoad": true
            },
            "name": {
                "description": "What to call it on the sign-in page",
                "type": "string",
                "isRequired": true,
                "isAlwaysLoad": true,
                "isLabelKey": true,
                "default": "Microsoft"
            },
            "kind": {
                "description": "Which provider",
                "type": "string",
                "format": "enum",
                "isRequired": true,
                "default": "azure-ad",
                "isAlwaysLoad": true,
                "dataList": [
                    {
                        "value": "azure-ad",
                        "label": "Microsoft Entra ID (Azure AD)"
                    },
                    {
                        "value": "oidc",
                        "label": "Any OpenID Connect provider"
                    }
                ]
            },
            "issuer": {
                "description": "Discovery URL or issuer. For Entra ID, https://login.microsoftonline.com/<directory>/v2.0",
                "type": "string",
                "isRequired": true
            },
            "clientId": {
                "description": "Application (client) id registered with the provider",
                "type": "string",
                "isRequired": true
            },
            "clientSecret": {
                "description": "Client secret. Stored encrypted",
                "type": "string",
                "format": "password",
                "isEncrypted": true
            },
            "isActive": {
                "description": "Whether this provider may be used",
                "type": "boolean",
                "isRequired": true,
                "default": true,
                "isAlwaysLoad": true
            },
            "isJustInTime": {
                "description": "Make an identity on a first sign-in the provider vouches for",
                "type": "boolean",
                "isRequired": true,
                "default": false
            },
            "defaultInstances": {
                "description": "Instances a just-in-time identity is granted, by database name",
                "type": "array"
            },
            "usernameClaim": {
                "description": "Claim to take the user name from",
                "type": "string",
                "isRequired": true,
                "default": "preferred_username"
            },
            "adminGroup": {
                "description": "Group claim that makes an identity an organization administrator",
                "type": "string"
            }
        }
    },
    {
        "name": "IdentityFederation",
        "plural": "IdentityFederations",
        "module": "Core",
        "inherits": "Document",
        "description": "A subject at an identity provider, and the identity it is (ADR-001 C.3)",
        "authorizations": [],
        "properties": {
            "identity": {
                "description": "Identity the subject signs in as",
                "type": {
                    "relation": "Identity",
                    "properties": [
                        "username",
                        "fullName",
                        "status"
                    ]
                },
                "isRequired": true,
                "isAlwaysLoad": true
            },
            "issuer": {
                "description": "Issuer that vouched for the subject",
                "type": "string",
                "isRequired": true,
                "isAlwaysLoad": true
            },
            "subject": {
                "description": "The provider's own id for the person. Never the email",
                "type": "string",
                "isRequired": true,
                "isAlwaysLoad": true
            },
            "provider": {
                "description": "Provider this link came from",
                "type": {
                    "relation": "IdentityProvider",
                    "properties": [
                        "name",
                        "kind"
                    ]
                }
            },
            "lastSignedIn": {
                "description": "Last successful sign-in through the provider",
                "type": "string",
                "format": "dateTime",
                "default": "null",
                "isReadOnly": true
            }
        }
    },
    {
        "name": "AdminAudit",
        "plural": "AdminAudits",
        "module": "Core",
        "inherits": "Document",
        "description": "Privileged actions: who did what, to whom, and on whose behalf",
        "authorizations": [],
        "properties": {
            "action": {
                "description": "What was done",
                "type": "string",
                "isRequired": true,
                "isAlwaysLoad": true,
                "isLabelKey": true
            },
            "occurred": {
                "description": "When it happened",
                "type": "string",
                "format": "dateTime",
                "isRequired": true,
                "isAlwaysLoad": true
            },
            "actor": {
                "description": "Identity that performed the action",
                "type": {
                    "relation": "Identity",
                    "properties": [
                        "username",
                        "fullName"
                    ]
                },
                "isAlwaysLoad": true
            },
            "onBehalfOf": {
                "description": "Organization the action was taken for",
                "type": {
                    "relation": "Organization",
                    "properties": [
                        "name"
                    ]
                }
            },
            "targetIdentity": {
                "description": "Identity the action was taken against",
                "type": {
                    "relation": "Identity",
                    "properties": [
                        "username",
                        "fullName"
                    ]
                }
            },
            "detail": {
                "description": "What changed",
                "type": "string",
                "format": "textArea"
            }
        }
    }
]
